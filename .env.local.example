# SMTP Configuration for Contact Form
# Update these values with your actual SMTP credentials

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Email Credentials
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_TO_EMAIL=piyushkumar61090@gmail.com

# Note: 
# 1. For Gmail, enable 2FA and generate an App Password
# 2. Replace 'your-email@gmail.com' with your actual Gmail
# 3. Replace 'your-app-password' with your generated App Password
# 4. Copy this file to .env.local and keep it secure
# 5. Never commit .env.local to version control
